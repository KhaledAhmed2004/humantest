{
  "name": "humantest",
  "version": "0.1.0",
  "description": "Human-readable end-to-end tests that compile to Playwright.",
  "private": true,
  "scripts": {
    "ht": "node src/cli.mts",
    "check": "node src/cli.mts check",
    "explain": "node src/cli.mts explain",
    "build": "node src/cli.mts build",
    "test": "node src/cli.mts run",
    "demo": "node src/cli.mts run --demo",
    "demo-app": "node demo-app/server.mjs",
    "typecheck": "tsc -p .",
    "ui": "npm run build -w ui && node src/ui/server.mts",
    "ui:dev": "npm run dev -w ui",
    "ui:qa": "node scripts/ui-qa.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "ffmpeg-static": "^5.3.0",
    "shadcn": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "workspaces": [
    "ui"
  ]
}
