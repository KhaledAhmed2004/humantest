// Turns parsed tests into a readable Playwright spec file.
// Every human sentence becomes one line of code, labelled with its .ht line number.

import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { emitStep } from './steps.mts';
import type { ParsedFile } from './parser.mts';
import type { Project } from './project.mts';

const s = (v: unknown) => JSON.stringify(v);
// The runtime that ships with this compiler, wherever the test project lives.
const RUNTIME = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', 'runtime', 'index.ts');
const posix = (p: string) => p.split(path.sep).join('/');
const relImport = (from: string, to: string) => {
  let r = posix(path.relative(from, to)).replace(/\.ts$/, '');
  if (!r.startsWith('.')) r = `./${r}`;
  return r;
};

const RESERVED = new Set(['u', 'ht', 'test', 'path', 'project', 'browser', 'testInfo', 'humantest']);

function varName(name: string, taken: Set<string>): string {
  const words = name.replace(/[^a-zA-Z0-9]+/g, ' ').trim().split(' ');
  let v = words.map((w, i) => (i === 0 ? w.toLowerCase() : w[0].toUpperCase() + w.slice(1).toLowerCase())).join('') || 'user';
  if (/^\d/.test(v) || RESERVED.has(v)) v = `user${v[0].toUpperCase()}${v.slice(1)}`;
  let out = v;
  for (let i = 2; taken.has(out); i++) out = `${v}${i}`;
  taken.add(out);
  return out;
}

export function generate(project: Project, parsed: ParsedFile): string {
  const outDir = project.outDir;
  const lines: string[] = [];
  const stateImports = new Map<string, string>(); // file -> identifier

  for (const t of parsed.tests) {
    if (t.state && !stateImports.has(t.state.file)) {
      const id = `state_${path.basename(t.state.file, '.ts').replace(/[^a-zA-Z0-9]+/g, '_')}`;
      stateImports.set(t.state.file, id);
    }
  }

  lines.push(`// Generated by HumanTest from ${parsed.relFile}. Do not edit this file; edit the .ht file instead.`);
  lines.push(`import path from 'node:path';`);
  lines.push(`import { test } from '@playwright/test';`);
  lines.push(`import { humantest } from ${s(relImport(outDir, RUNTIME))};`);
  for (const [file, id] of stateImports) lines.push(`import ${id} from ${s(relImport(outDir, file))};`);
  lines.push('');
  lines.push(`const project = {`);
  lines.push(`  configPath: path.join(__dirname, ${s(posix(path.relative(outDir, project.configPath)))}),`);
  lines.push(`  source: ${s(parsed.relFile)},`);
  lines.push(`};`);

  for (const t of parsed.tests) {
    const taken = new Set<string>();
    const vars = new Map(t.users.map((u) => [u.name, varName(u.name, taken)]));

    lines.push('');
    lines.push(`// ${parsed.relFile}:${t.line}`);
    lines.push(`test(${s(t.name)}, async ({ browser }, testInfo) => {`);
    lines.push(`  await humantest({ browser, testInfo, line: ${t.line}, ...project }, async (ht) => {`);
    if (t.state) {
      lines.push(`    await ht.startWith(${t.state.line}, ${s(t.state.name)}, ${s(t.state.args)}, ${stateImports.get(t.state.file)});`);
    }
    for (const u of t.users) lines.push(`    const ${vars.get(u.name)} = await ht.user(${u.line}, ${s(u.name)});`);

    let lastHeading: string | undefined;
    for (const st of t.steps) {
      // A comment whenever the story line or the user changes, so the code reads like the .ht file.
      const heading = st.story ? `${st.story.line}: ${st.story.text}` : `As ${st.user}`;
      if (heading !== lastHeading) {
        lines.push('');
        lines.push(`    // ${heading}`);
        lastHeading = heading;
      }
      const label = st.story ? `${st.story.text} › ${st.text}` : st.text;
      lines.push(`    await ${vars.get(st.user)}.step(${st.line}, ${s(label)}, (u) => ${emitStep(st.def, st.args)});`);
    }
    lines.push(`  });`);
    lines.push(`});`);
  }
  lines.push('');
  return lines.join('\n');
}
